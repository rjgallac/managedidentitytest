{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "queues": {
      "messageEncoding": "none"
    }
  },
  "tracing": {
    "consoleLevel": "verbose",
    "fileLoggingMode": "always"
  },
  "logging": {
    "logLevel": {
      "default": "Debug"
    }
  }
}
